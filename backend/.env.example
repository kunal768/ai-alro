# ── Service URLs (used inside Docker; override to localhost for local dev) ──────
ERP_SERVICE_URL=http://erp_service:8001
INTAKE_AGENT_URL=http://intake_agent:8002
OPTIMIZER_AGENT_URL=http://optimizer_agent:8003
REASONER_AGENT_URL=http://reasoner_agent:8004

# ── LLM Provider ───────────────────────────────────────────────────────────────
# Choose one: anthropic | openai | ollama
LLM_PROVIDER=anthropic

# Model name for the chosen provider:
#   anthropic → claude-sonnet-4-6  (or claude-opus-4-7 for stronger reasoning)
#   openai    → gpt-4o
#   ollama    → llama3.2  (or mistral, phi3, etc.)
LLM_MODEL=claude-sonnet-4-6

# Sampling temperature (0 = deterministic/reproducible, 1 = default creative).
# Pin to 0 so consecutive runs of the same scenario produce identical token streams.
LLM_TEMPERATURE=0

# ── Provider API keys ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here        # only needed for provider=openai

# ── Ollama (local) ─────────────────────────────────────────────────────────────
# Run: ollama serve && ollama pull llama3.2
# The base URL below is the OpenAI-compatible endpoint Ollama exposes.
OLLAMA_BASE_URL=http://localhost:11434/v1
